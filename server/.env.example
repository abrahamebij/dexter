# Required for execution. Keep this file on the worker only.
BOT_PRIVATE_KEY=
DRY_RUN=true

# Required for Railway PostgreSQL persistence.
DATABASE_URL=
# Set true only when your PostgreSQL provider requires TLS.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# The deployed Vercel origin, for example https://dexter.example.com
CORS_ORIGIN=http://localhost:5173

# Optional compiler configuration.
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
GEMINI_MODEL=
GUARDIAN_SLIPPAGE_BPS=100
